{
  "name": "wxnodus",
  "version": "3.1.0",
  "type": "module",
  "description": "WxNodus V3 — Windows 本地 AI agent CLI（Node22 + TypeScript）",
  "bin": {
    "wxnodus": "dist/cli/index.js",
    "wxn": "dist/cli/index.js"
  },
  "scripts": {
    "build": "npm run clean && npm run build:ink && tsc",
    "build:ink": "npm --prefix packages/wxnodus-ink run build",
    "dev": "tsx src/cli/index.ts",
    "start": "tsx src/cli/index.ts",
    "test": "npm run test:all",
    "ci": "npm run typecheck && npm run typecheck:tests && npm run test:all && npm run test:known-failures && npm run check:test-discovery && npm run check:requirement-coverage && npm run build",
    "test:all": "vitest run --config vitest.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "check:test-discovery": "node scripts/check-test-discovery.mjs",
    "check:requirement-coverage": "node scripts/check-requirement-coverage.mjs",
    "test:known-failures": "vitest run --config vitest.known-failures.config.ts",
    "drill:wave0-recovery": "npm exec -- tsx scripts/drill-wave0-recovery.ts",
    "gate:wave0": "node scripts/run-wave-gates.mjs --wave 0",
    "test:w1-01": "vitest run tests/wave1/w1-01-protocol.test.ts",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test:w1-02": "vitest run tests/wave1/w1-02-bootstrap.test.ts",
    "test:w1-03": "vitest run tests/wave1/w1-03-http-gateway-security.test.ts",
    "test:w1-04": "vitest run tests/wave1/w1-04-command-contract.test.ts",
    "test:w1-05": "vitest run tests/wave1/w1-05-tool-catalog.test.ts",
    "test:w1-06": "vitest run tests/wave1/w1-06-memory-durability.test.ts",
    "test:w1-07": "vitest run tests/wave1/w1-07-security-control-plane.test.ts",
    "test:w1-08": "vitest run tests/wave1/w1-08-tool-execution-pipeline.test.ts",
    "test:w1-09": "vitest run tests/wave1/w1-09-trusted-completion.test.ts",
    "test:w1-10": "vitest run tests/wave1/w1-10-offline-provider.test.ts",
    "test:w1-11": "vitest run tests/wave1/w1-11-capability-gate.test.ts",
    "test:w2-01": "vitest run tests/w2-config-onboarding.contract.test.ts",
    "test:w2-02": "vitest run tests/w2-personalization.contract.test.ts",
    "test:w2-03": "vitest run tests/w2-capability-registry.contract.test.ts",
    "test:w2-04": "vitest run tests/w2-extension-scope.contract.test.ts",
    "test:w2-05": "vitest run tests/w2-session-lifecycle-hooks.contract.test.ts",
    "test:w2-06": "vitest run tests/w2-mcp-duplex.contract.test.ts",
    "test:w2-07": "vitest run tests/w2-skill-lifecycle.contract.test.ts",
    "test:w2-08": "vitest run tests/w2-plugin-sandbox.contract.test.ts",
    "test:w2-09": "vitest run tests/w2-autonomy-persistence-budget.contract.test.ts",
    "test:w2-10": "vitest run tests/w2-subagent-recovery-progress.contract.test.ts",
    "test:w2-10-ext": "vitest run tests/w2-subagent-worktree-recovery.contract.test.ts",
    "test:w2-11": "vitest run tests/w2-wave2-migration-gate.contract.test.ts",
    "test:goal-exports": "vitest run tests/session-start-mcp-generation.contract.test.ts tests/branding-personalization.contract.test.ts tests/cli-first-run-language.test.ts tests/vision-capture-negotiator.contract.test.ts",
    "demo:session-start": "npm exec -- tsx scripts/generate-session-start.ts",
    "demo:mcp-server": "npm exec -- tsx scripts/generate-mcp-server.ts",
    "demo:personalize": "npm exec -- tsx scripts/personalize-wxnodus.ts",
    "test:w3-01": "vitest run tests/unit/quality/verifierRegistry.contract.test.ts tests/unit/quality/completionGate.closed-evidence.test.ts tests/integration/evidenceAuthorityConflict.test.ts tests/integration/failurePropagation.test.ts",
    "test:w3-02": "vitest run tests/unit/tui/reducer-projector.contract.test.ts tests/contract/gatewayClient.contract.test.ts tests/integration/frontendParity.test.ts",
    "test:w3-03": "vitest run tests/unit/voice/audioDeviceService.test.ts tests/unit/voice/voice-domain.contract.test.ts tests/unit/voice/wavWriter.test.ts",
    "test:w3-04": "vitest run tests/failure/voiceWorkerFailure.test.ts tests/integration/voiceSession.test.ts tests/integration/voiceHeadlessParity.test.ts",
    "test:w3-05": "vitest run tests/unit/computer/highImpactApproval.test.ts tests/unit/computer/postcondition.test.ts tests/integration/computerUsePipeline.test.ts tests/integration/computerFrontendParity.test.ts tests/integration/emergencyStop.test.ts",
    "test:w3-06": "vitest run tests/unit/computer/driverContracts.test.ts tests/integration/browserIsolation.test.ts tests/failure/driverFallback.test.ts",
    "test:w3-07": "vitest run tests/unit/build/buildContracts.test.ts tests/integration/buildService.test.ts",
    "test:w3-08": "vitest run tests/integration/buildRestartReadback.test.ts tests/integration/buildEvidenceDecision.test.ts tests/failure/buildVerifierFailure.test.ts",
    "test:pty-contract": "vitest run tests/contract/pty.contract.test.ts tests/failure/ptyLifecycle.test.ts",
    "provision:windows-runner": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/provision-windows-runner.ps1",
    "verify:windows-fixtures": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tests/fixtures/windows/uia/build-fixtures.ps1 -VerifyLock",
    "test:windows-real": "node scripts/run-windows-acceptance.mjs --aggregate-receipts",
    "test:windows-real:win11-production": "node scripts/run-windows-acceptance.mjs --produce-receipt --os-key win11-24h2",
    "test:windows-real:win10-legacy": "node scripts/run-windows-acceptance.mjs --produce-receipt --os-key win10-22h2",
    "test:w3-11": "vitest run tests/integration/wave3-current-migration-recovery.test.ts tests/integration/wave3-headless-e2e.test.ts tests/integration/wave3-legacy-bypass.test.ts tests/integration/wave3-gate-scope.test.ts",
    "gate:wave3-a": "npm run build && npm run typecheck && npm run typecheck:tests",
    "test:wave3-headless": "vitest run tests/integration/wave3-headless-e2e.test.ts",
    "test:wave3-security": "vitest run tests/integration/wave3-legacy-bypass.test.ts",
    "drill:wave3-recovery": "node scripts/drill-wave3-recovery.mjs",
    "gate:completion": "node scripts/run-completion-gate.mjs",
    "gate:wave3": "node scripts/run-wave3-gates.mjs",
    "migration:drill:wave2": "node scripts/run-wave2-migration-drill.mjs",
    "gate:wave2": "node scripts/run-wave2-gates.mjs",
    "test:wave1:trusted-kernel": "vitest run tests/wave1/w1-01-protocol.test.ts tests/wave1/w1-02-bootstrap.test.ts tests/wave1/w1-03-http-gateway-security.test.ts tests/wave1/w1-04-command-contract.test.ts tests/wave1/w1-05-tool-catalog.test.ts tests/wave1/w1-06-memory-durability.test.ts tests/wave1/w1-07-security-control-plane.test.ts tests/wave1/w1-08-tool-execution-pipeline.test.ts tests/wave1/w1-09-trusted-completion.test.ts tests/wave1/w1-10-offline-provider.test.ts tests/wave1/w1-11-capability-gate.test.ts",
    "gate:wave1": "node scripts/run-wave1-gates.mjs",
    "migration:drill:wave1": "node scripts/run-wave1-migration-drill.mjs",
    "memory:curate": "npm exec -- tsx scripts/memory-curator.ts",
    "demo:installer": "npm exec -- tsx scripts/package-installer.ts",
    "check:release-eligibility": "node scripts/check-release-eligibility.mjs",
    "import:release-evidence": "node scripts/import-release-evidence.mjs",
    "resolve:requirement-evidence": "node scripts/resolve-requirement-evidence.mjs",
    "pack:release": "node scripts/freeze-candidate.mjs",
    "gate:h": "node scripts/run-gate-h.mjs",
    "gate:i": "node scripts/run-gate-i.mjs",
    "release:finalize": "node scripts/finalize-release.mjs",
    "check:release-surface": "node scripts/check-release-surface.mjs",
    "evidence:memory-capacity": "node scripts/evidence-memory-capacity.mjs",
    "evidence:mcp-e2e": "node scripts/evidence-mcp-e2e.mjs",
    "evidence:voice-capture": "node scripts/evidence-voice-capture.mjs",
    "evidence:windows-acceptance": "node scripts/evidence-windows-acceptance.mjs",
    "evidence:windows-ecosystem": "node scripts/evidence-windows-ecosystem.mjs",
    "evidence:multimonitor-math": "node scripts/evidence-multimonitor-math.mjs",
    "eval": "node scripts/eval-report.mjs",
    "eval:full": "node scripts/eval-report.mjs --full"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.0.0",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@wxnodus/ink": "file:packages/wxnodus-ink",
    "better-sqlite3": "^11.3.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-math": "^3.0.0",
    "micromark": "^4.0.2",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0",
    "node-pty": "^1.1.0",
    "node-screenshots": "^0.2.8",
    "playwright-core": "^1.62.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.8",
    "robotjs": "^0.9.1",
    "sqlite-vec": "^0.1.6",
    "undici": "^7.0.0",
    "unicode-animations": "^1.0.3",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.4",
    "ink-testing-library": "^4.0.0",
    "postject": "^1.0.0-alpha.6",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "os": [
    "win32"
  ],
  "license": "Apache-2.0",
  "files": [
    "dist",
    "packages/wxnodus-ink/dist",
    "packages/wxnodus-ink/index.js",
    "packages/wxnodus-ink/index.d.ts",
    "packages/wxnodus-ink/text-input.js",
    "packages/wxnodus-ink/text-input.d.ts",
    "packages/wxnodus-ink/package.json",
    "packages/wxnodus-ink/LICENSE",
    "README.md",
    "LICENSE"
  ],
  "bundledDependencies": [
    "@wxnodus/ink"
  ],
  "prepack": "npm run build"
}
